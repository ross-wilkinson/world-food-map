{
  "name": "world-food-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "data:download": "node scripts/download.mjs",
    "data:build": "python scripts/extract_trade.py && python scripts/extract_fbs.py && node scripts/centroids.mjs && python scripts/build.py",
    "check:shots": "node scripts/review.mjs",
    "check:interactions": "node scripts/interactions.mjs"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-drag": "^3.0.0",
    "d3-format": "^3.1.2",
    "d3-geo": "^3.1.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-timer": "^3.0.1",
    "topojson-client": "^3.1.0",
    "versor": "^0.2.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-format": "^3.0.4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-timer": "^3.0.2",
    "@types/topojson-client": "^3.1.5",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "description": "Interactive globe of world staple-crop trade flows, built on FAOSTAT"
}
